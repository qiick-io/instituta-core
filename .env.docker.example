APP_NAME=Instituta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

RUN_MIGRATIONS=true
CACHE_CONFIG=true

DB_CONNECTION=sqlite
# DB_DATABASE is set in compose for the container path

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=log

